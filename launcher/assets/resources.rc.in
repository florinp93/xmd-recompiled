IDI_ICON1 ICON "xmd_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @XMD_VERSION_MAJOR@,@XMD_VERSION_MINOR@,@XMD_VERSION_PATCH@,@XMD_VERSION_BUILD@
PRODUCTVERSION @XMD_VERSION_MAJOR@,@XMD_VERSION_MINOR@,@XMD_VERSION_PATCH@,@XMD_VERSION_BUILD@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "X-Men Destiny PC Port Launcher"
            VALUE "FileVersion", "@XMD_VERSION_STRING@"
            VALUE "InternalName", "xmd_launcher"
            VALUE "OriginalFilename", "xmd_launcher.exe"
            VALUE "ProductName", "X-Men Destiny PC Port"
            VALUE "ProductVersion", "@XMD_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
